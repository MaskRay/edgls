# Build the EDG C/C++ front end as a static library (edgfe) from an EDG source
# checkout. The front end is configured as a callable, multi-threaded library
# whose back end is provided by edgls (src/edg/host.cc).

set(EDG_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../edgcpp-compiler" CACHE PATH
    "Path to an EDG front end checkout")
if(APPLE)
  set(edg_default_conf "macos-arm-clang-release")
elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
  set(edg_default_conf "linux-clang-release")
else()
  set(edg_default_conf "linux-gcc-release")
endif()
set(EDG_MACRO_CONF "${edg_default_conf}" CACHE STRING
    "EDG macro configuration (a directory under cmake/macro-conf)")
get_filename_component(EDG_SOURCE_DIR "${EDG_SOURCE_DIR}" ABSOLUTE)
if(NOT EXISTS "${EDG_SOURCE_DIR}/src/cfe.c")
  message(FATAL_ERROR "EDG_SOURCE_DIR (${EDG_SOURCE_DIR}) is not an EDG checkout")
endif()
message(STATUS "Using EDG front end from ${EDG_SOURCE_DIR}")

find_package(Python3 REQUIRED COMPONENTS Interpreter)
find_program(PATCH_EXECUTABLE patch REQUIRED)

set(EDG_BUILD_DIR "${CMAKE_BINARY_DIR}/edg")
set(EDG_PATCHED_SRC "${EDG_BUILD_DIR}/src")
set(EDG_INCLUDE_OUT "${EDG_BUILD_DIR}/include")
file(MAKE_DIRECTORY "${EDG_INCLUDE_OUT}")

# Copy the front end sources and apply edgls's hooks. Redone whenever the
# patches or the copied files change.
file(GLOB EDG_PATCHES CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../edg/patches/*.patch")
list(SORT EDG_PATCHES)
file(GLOB EDG_ORIG_FILES "${EDG_SOURCE_DIR}/src/*.c" "${EDG_SOURCE_DIR}/src/*.h"
     "${EDG_SOURCE_DIR}/src/*.txt" "${EDG_SOURCE_DIR}/src/*.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${EDG_PATCHES} ${EDG_ORIG_FILES})
file(REMOVE_RECURSE "${EDG_PATCHED_SRC}")
file(COPY ${EDG_ORIG_FILES} DESTINATION "${EDG_PATCHED_SRC}")
foreach(p ${EDG_PATCHES})
  execute_process(COMMAND "${PATCH_EXECUTABLE}" -s -p1 -i "${p}"
                  WORKING_DIRECTORY "${EDG_BUILD_DIR}"
                  RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Failed to apply ${p} to the EDG sources")
  endif()
endforeach()

# Macro configuration: cmake_defines.h comes from the base configuration and
# the compile definitions from the cpfe configuration, with the back end
# settings replaced by edgls's.
set(EDG_CMAKEDEF "${EDG_SOURCE_DIR}/dev_tools/bin/edg-cmakedef")
set(EDG_MACRO_ROOT "${EDG_SOURCE_DIR}/cmake/macro-conf")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${EDG_CMAKEDEF}" "${EDG_MACRO_ROOT}"
                        "${EDG_MACRO_ROOT}/${EDG_MACRO_CONF}/base.cmakedef" print-defines
                OUTPUT_VARIABLE edg_defines RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "edg-cmakedef failed for ${EDG_MACRO_CONF}/base")
endif()
file(WRITE "${EDG_INCLUDE_OUT}/cmake_defines.h.tmp" "${edg_defines}\n")
file(COPY_FILE "${EDG_INCLUDE_OUT}/cmake_defines.h.tmp" "${EDG_INCLUDE_OUT}/cmake_defines.h" ONLY_IF_DIFFERENT)

execute_process(COMMAND "${Python3_EXECUTABLE}" "${EDG_CMAKEDEF}" "${EDG_MACRO_ROOT}"
                        "${EDG_MACRO_ROOT}/${EDG_MACRO_CONF}/cpfe.cmakedef" print-values
                OUTPUT_VARIABLE edg_values OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "edg-cmakedef failed for ${EDG_MACRO_CONF}/cpfe")
endif()
string(REPLACE "\n" ";" edg_values "${edg_values}")
set(EDG_OVERRIDES
  BACK_END_IS_C_GEN_BE=0
  BACK_END_IS_CP_GEN_BE=0
  BACK_END_SHOULD_BE_CALLED=1
  CALL_BACK_END_EVEN_WITH_ERRORS=1
  DO_IL_LOWERING=0
  LOWER_FIXED_POINT=0
  LOWER_IFUNC=0
  RECORD_BACKING_EXPRS_WITH_IL_LOWERING=0
  COMPILE_MULTIPLE_TRANSLATION_UNITS=0
  NEED_IL_DISPLAY=0
  EDG_FRONT_END_DAEMON=0
  MAKE_FRONT_END_CALLABLE=1
  MULTIPLE_THREAD_COMPILATION=1
  CUSTOM_DEFAULT_OUTPUT_FILES=1
  # No prelinker: do not write .ti files next to sources.
  AUTOMATIC_TEMPLATE_INSTANTIATION=0)
set(EDG_DEFINITIONS "")
foreach(v ${edg_values} ${EDG_OVERRIDES})
  string(REGEX REPLACE "=.*" "" key "${v}")
  list(FILTER EDG_DEFINITIONS EXCLUDE REGEX "^${key}(=|$)")
  list(APPEND EDG_DEFINITIONS "${v}")
endforeach()
list(APPEND EDG_DEFINITIONS USE_CMAKE_DEFINES)

# err_codes.h and err_data.h are generated by mk_errinfo, a host tool.
add_executable(edg_mk_errinfo "${EDG_SOURCE_DIR}/util/mk_errinfo.c")
set_source_files_properties("${EDG_SOURCE_DIR}/util/mk_errinfo.c" PROPERTIES LANGUAGE CXX)
set_target_properties(edg_mk_errinfo PROPERTIES CXX_STANDARD 14)
target_include_directories(edg_mk_errinfo PRIVATE "${EDG_SOURCE_DIR}/src")
set(EDG_TXT_FILES "${EDG_PATCHED_SRC}/error_msg.txt" "${EDG_PATCHED_SRC}/error_tag.txt")
set(EDG_ERR_H_FILES "${EDG_INCLUDE_OUT}/err_codes.h" "${EDG_INCLUDE_OUT}/err_data.h")
add_custom_command(OUTPUT ${EDG_ERR_H_FILES}
                   COMMAND edg_mk_errinfo ${EDG_TXT_FILES} ${EDG_ERR_H_FILES}
                   DEPENDS edg_mk_errinfo ${EDG_TXT_FILES}
                   COMMENT "Generating EDG err_codes.h and err_data.h")
add_custom_target(edg_error_info DEPENDS ${EDG_ERR_H_FILES})

set(EDG_CORE_SOURCES
  attribute.c c_gen_be.c cfe.c class_decl.c cmd_line.c const_ints.c
  cp_gen_be.c debug.c decl_inits.c decl_spec.c declarator.c decls.c def_arg.c
  disambig.c error.c expr.c exprutil.c extasm.c fe_init.c fe_wrapup.c
  fixed_pt.c float_pt.c floating.c folding.c func_def.c host_envir.c
  ifc_modules.c il.c il_alloc.c il_display.c il_read.c il_to_str.c il_walk.c
  il_write.c inline.c interpret.c layout.c lexical.c literals.c lookup.c
  lower_c99.c lower_eh.c lower_il.c lower_init.c lower_name.c macro.c
  mem_manage.c modules.c ms_attrib.c overload.c pch.c pragma.c preproc.c
  scope_stk.c src_seq.c statements.c symbol_ref.c symbol_tbl.c sys_predef.c
  target.c templates.c trans_copy.c trans_corresp.c trans_unit.c types.c)
foreach(f ifc_map_functions.c ifc_map_functions_acc.c ifc_map_functions_dbg.c
          ifc_map_functions_mut.c ifc_map_functions_val.c ifc_modules_read.c
          ifc_modules_templ.c ifc_modules_write.c unicode_name_fsm.c)
  if(EXISTS "${EDG_PATCHED_SRC}/${f}")
    list(APPEND EDG_CORE_SOURCES ${f})
  endif()
endforeach()
list(TRANSFORM EDG_CORE_SOURCES PREPEND "${EDG_PATCHED_SRC}/")
set_source_files_properties(${EDG_CORE_SOURCES} PROPERTIES LANGUAGE CXX)

add_library(edgfe STATIC ${EDG_CORE_SOURCES})
add_dependencies(edgfe edg_error_info)
# The front end's globals are thread_local. Keep the TLS model cheap.
set_target_properties(edgfe PROPERTIES CXX_STANDARD 14 CXX_EXTENSIONS OFF
                                       POSITION_INDEPENDENT_CODE OFF)
target_compile_definitions(edgfe PUBLIC ${EDG_DEFINITIONS})
target_include_directories(edgfe PUBLIC "${EDG_PATCHED_SRC}" "${EDG_INCLUDE_OUT}")
if(NOT MSVC)
  # edgfe is linked into an executable, where the cheapest TLS model applies.
  target_compile_options(edgfe PRIVATE -w -fno-exceptions -fno-rtti -ftls-model=local-exec)
endif()

# A predefined macro file for the host compilers, used as the default EDG_BASE.
set(EDG_DEFAULT_BASE "${EDG_BUILD_DIR}/base")
if(NOT EXISTS "${EDG_DEFAULT_BASE}/lib/predefined_macros.txt")
  # GNU and clang emulation entries use distinct mode tags, so the outputs of
  # the two runs can be concatenated.
  find_program(EDG_HOST_GCC gcc)
  find_program(EDG_HOST_GXX g++)
  find_program(EDG_HOST_CLANG clang)
  set(predef "")
  foreach(flavor gnu clang)
    if(flavor STREQUAL "gnu" AND EDG_HOST_GCC AND EDG_HOST_GXX)
      set(predef_args --gcc "${EDG_HOST_GCC}" "--g++" "${EDG_HOST_GXX}")
    elseif(flavor STREQUAL "clang" AND EDG_HOST_CLANG)
      set(predef_args --clang "${EDG_HOST_CLANG}")
    else()
      continue()
    endif()
    set(dir "${EDG_BUILD_DIR}/predef-${flavor}")
    file(MAKE_DIRECTORY "${dir}")
    execute_process(COMMAND sh "${EDG_SOURCE_DIR}/util/make_predef_macro_table" ${predef_args}
                    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    if(rc EQUAL 0 AND EXISTS "${dir}/predefined_macros.txt")
      file(READ "${dir}/predefined_macros.txt" content)
      string(APPEND predef "${content}")
    endif()
  endforeach()
  if(predef STREQUAL "")
    message(WARNING "make_predef_macro_table failed; set edg.base at run time")
  else()
    file(WRITE "${EDG_DEFAULT_BASE}/lib/predefined_macros.txt" "${predef}")
  endif()
endif()
